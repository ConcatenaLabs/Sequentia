[Unit]
Description=Publish new Sequentia releases to the download page
Documentation=file:/root/sequentia/release-build/publisher/contrib/sequentia/release-publisher/README.md
# Nothing to do without the network, and a failed ls-remote is a wasted wake-up.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# The publisher runs from its OWN clone, pinned to master, and never from a
# product's checkout. It used to live in src/node -- the same tree the node recipe
# checks out to build from -- so the moment it built a release it checked out that
# tag on top of itself and replaced its own script and recipes with whatever
# version the tag carried. The next run then executed months-old code that knew
# about one product.
ExecStartPre=/usr/bin/git -C /root/sequentia/release-build/publisher fetch --quiet origin
ExecStartPre=/usr/bin/git -C /root/sequentia/release-build/publisher reset --quiet --hard origin/master
ExecStart=/root/sequentia/release-build/publisher/contrib/sequentia/release-publisher/publish-release.sh

# Updating in ExecStartPre rather than inside the script is deliberate: a script
# that rewrites itself mid-run keeps executing the old copy while sourcing new
# recipes. Here the update finishes in its own process before the script is read.

# A release build takes hours on a box that is also producing blocks; do not let
# systemd kill it half way through and leave a half-written artifact.
TimeoutStartSec=infinity
# The build is already niced inside the script; this keeps it off the CPU that
# the committee needs even when the script is invoked by hand.
Nice=19
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
